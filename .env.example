# Supabase (https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# App Environment
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Apify (https://apify.com) — Instagram scraping
APIFY_API_TOKEN=your-apify-token

# OpenRouter (https://openrouter.ai) — AI Script generation (Claude models)
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6

# Cron Secret for Scheduled Scrapers
CRON_SECRET=your-secure-random-secret

# Creem Merchant of Record & Checkout (https://creem.io)
CREEM_API_KEY=creem_live_your-api-key
CREEM_PRODUCT_ID=prod_your-approved-product-id
# Optional: separate products for monthly vs annual
# CREEM_PRODUCT_ID_MONTHLY=prod_monthly
# CREEM_PRODUCT_ID_ANNUAL=prod_annual
# Optional hosted payment link fallback (full URL or prod_xxx)
# NEXT_PUBLIC_CREEM_CHECKOUT_URL=https://www.creem.io/payment/prod_your-id
# CREEM_WEBHOOK_SECRET=your-creem-webhook-secret
# CREEM_API_URL=https://api.creem.io

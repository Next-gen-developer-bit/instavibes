# Supabase (https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# App Environment
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Apify (https://apify.com) — Instagram scraping
APIFY_API_TOKEN=your-apify-token

# OpenRouter (https://openrouter.ai) — AI Script generation (Claude models)
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6

# Cron Secret for Scheduled Scrapers
CRON_SECRET=your-secure-random-secret

# Creem Merchant of Record & Checkout (https://creem.io)
NEXT_PUBLIC_CREEM_CHECKOUT_URL=https://checkout.creem.io/your-product-id
# NEXT_PUBLIC_CREEM_CHECKOUT_URL_MONTHLY=https://checkout.creem.io/monthly-id
# NEXT_PUBLIC_CREEM_CHECKOUT_URL_ANNUAL=https://checkout.creem.io/annual-id
# CREEM_API_KEY=your-creem-api-key
# CREEM_WEBHOOK_SECRET=your-creem-webhook-secret
